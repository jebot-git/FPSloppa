[Unit]
Description=FPSloppa public dedicated server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/fpsloppa/current
ExecStart=%h/.local/share/fpsloppa/current/FPSloppaServer.x86_64 --log-file %h/.local/share/fpsloppa/server-engine.log -- --config %h/.config/fpsloppa/server.cfg
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
NoNewPrivileges=true
UMask=0027

[Install]
WantedBy=default.target
