import os
bindings = ARGUMENTS.get('bindings', '../../external-tools/godot-cpp-native')
server = ARGUMENTS.get('server', 'no') == 'yes'
env = SConscript(os.path.join(bindings, 'SConstruct'), {'api_version':'4.7'})
env.Append(CPPPATH=['src'])
env.Append(CXXFLAGS=['-ffp-contract=off'])
if env['platform']=='windows':env.Append(LINKFLAGS=['-static'])
if env['platform']=='android':env.Append(LINKFLAGS=['-Wl,-z,max-page-size=16384'])
sources=['src/register_server.cpp' if server else 'src/register.cpp','src/codec.cpp','src/network_packing.cpp','src/destruction_runtime.cpp','src/movement_runtime.cpp','src/world_runtime.cpp','src/world_terrain.cpp','src/backend.cpp','src/player_simulation.cpp','src/snapshot_preparation.cpp','src/authority_cq_snapshot.cpp','src/authority_cq.cpp','src/authority_squads.cpp','src/authority_vehicles.cpp', 'src/authority_ai.cpp','src/authority_protocol.cpp','src/authority_melee.cpp','src/authority_round.cpp','src/authority_entities.cpp','src/authority_abilities.cpp','src/authority_ballistics.cpp', 'src/authority_terrain.cpp','src/authority_collision.cpp','src/authority_queries.cpp','src/authority_utilities.cpp','src/authority_gameplay.cpp','src/authority_snapshot.cpp','src/authority_state.cpp','src/authority_vr.cpp','src/authority_core.cpp','src/authority_world.cpp','src/authority.cpp']
if server:env.Append(CPPDEFINES=['FPS_SERVER'])
else:sources+=['src/standalone_client.cpp','src/avatar_runtime.cpp','src/audio_runtime.cpp','src/poses.cpp','src/pose_preparation.cpp','src/avatar_channels.cpp']
library=env.SharedLibrary('build-scons/libfpsloppa_native'+env['suffix']+env['SHLIBSUFFIX'],sources)

Default(library)
