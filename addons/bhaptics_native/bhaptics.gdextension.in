[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.5"
reloadable = false
android_aar_plugin = true

[libraries]
linux.debug.x86_64 = "res://addons/bhaptics_native/bin/libfpsloppa_bhaptics_native.so"
linux.release.x86_64 = "res://addons/bhaptics_native/bin/libfpsloppa_bhaptics_native.so"

windows.debug.x86_64 = "res://addons/bhaptics_native/bin/fpsloppa_bhaptics_native.dll"
windows.release.x86_64 = "res://addons/bhaptics_native/bin/fpsloppa_bhaptics_native.dll"
android.debug.arm64 = "res://addons/bhaptics_native/bin/libfpsloppa_bhaptics_native.android.so"
android.release.arm64 = "res://addons/bhaptics_native/bin/libfpsloppa_bhaptics_native.android.so"
