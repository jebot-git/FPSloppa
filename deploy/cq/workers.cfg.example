[cq]
role = workers
cluster = config/cluster.json
state = /var/lib/fpsloppa-cq
binary = server/FPSloppaServer.x86_64
districts = d00 d01 d02 d03 d04 d05 d06 d07 d08 d09 d10 d11
# Remove whole four-district regions to use fewer workers per VPS.
# Gameplay is fixed: CQ, UT99, 128 players globally, 16 per district.
