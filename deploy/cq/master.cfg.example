[cq]
role = master
cluster = config/cluster.json
state = /var/lib/fpsloppa-cq
binary = server/FPSloppaServer.x86_64
index = 0
content_listen = 10.77.0.10:8080
# For HA, deploy three masters and use the same three-member etcd quorum:
# etcd = http://10.77.0.10:2379 http://10.77.0.12:2379 http://10.77.0.13:2379
