; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="FPSloppa"
config/version="0.16v-cq-experimental"
run/main_scene="res://deathmatch/entry.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://deathmatch/icon-final.png"
run/flush_stdout_on_print.dedicated_server=true

[audio]

driver/enable_input=true

[autoload]

XRToolsUserSettings="*uid://bqgb8i74tm0t"
XRToolsRumbleManager="*uid://by853dk86g1qw"

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/entryway_export/plugin.cfg", "res://addons/godot-xr-tools/plugin.cfg", "res://addons/bsp_importer/plugin.cfg", "res://addons/openscad_import/plugin.cfg")

[filesystem]

import/blender/enabled=false

[navigation]

3d/default_cell_size=0.2
3d/default_cell_height=0.1

[physics]

3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/use_enhanced_internal_edge_removal=true
jolt_physics_3d/queries/use_enhanced_internal_edge_removal=true
jolt_physics_3d/motion_queries/use_enhanced_internal_edge_removal=true
common/physics_interpolation=true

[rendering]

rendering_device/driver="vulkan"
rendering_device/driver.windows="vulkan"
rendering_device/driver.linuxbsd="vulkan"
rendering_device/driver.android="vulkan"
rendering_device/fallback_to_d3d12=false
rendering_device/fallback_to_opengl3=false
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
textures/vram_compression/import_etc2_astc=true
occlusion_culling/use_occlusion_culling=true

[xr]

openxr/enabled=true
openxr/default_action_map="res://deathmatch/vr/actions.tres"
openxr/foveation_level=2
openxr/foveation_dynamic=true
openxr/extensions/hand_tracking=false
openxr/extensions/hand_tracking_unobstructed_data_source=false
openxr/extensions/hand_tracking_controller_data_source=false
openxr/extensions/eye_gaze_interaction=true
shaders/enabled=true
openxr/extensions/meta/body_tracking=false
openxr/extensions/meta/face_tracking=false
openxr/extensions/automatically_request_runtime_permissions=false
openxr/enabled.dedicated_server=false

[shader_globals]

cq_lamp_position0={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
cq_lamp_position1={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
cq_lamp_position2={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
cq_lamp_position3={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
cq_lamp_axis0={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
cq_lamp_axis1={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
cq_lamp_axis2={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
cq_lamp_axis3={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}


jungle_weather={
"type": "vec3",
"value": Vector3(0,0,0)
}

jungle_baked_enabled={
"type": "bool",
"value": false
}
jungle_day_mix={
"type": "float",
"value": 1.0
}
jungle_extent={
"type": "float",
"value": 2828.427
}
jungle_light_atlas={
"type": "sampler2D",
"value": "res://experimental-assets/jungle/lighting/irradiance.png"
}

jungle_dawn_atlas={
"type": "sampler2D",
"value": "res://experimental-assets/jungle/lighting/dawn.png"
}
jungle_sun_mix={
"type": "vec3",
"value": Vector3(1,0,0)
}
jungle_sky_color={
"type": "vec3",
"value": Vector3(0.15,0.3,0.5)
}
jungle_sky_stage={
"type": "vec3",
"value": Vector3(0,0,0)
}

[importer_defaults]

texture={
"mipmaps/generate": true
}
