extends SceneTree
const Points=preload("res://deathmatch/conquest/frontier/points.gd")
var failures:Array=[]
func _initialize() -> void:run.call_deferred()
func check(ok:bool,label:String) -> void:
	print("PASS " if ok else "FAIL ",label)
	if not ok:failures.append(label)
func run() -> void:
	var rules:=Points.new();rules.reset(3)
	check(rules.owners==[-1,-1,-1] and rules.kill(0)==0,"Neutral start and no kill points with zero held POIs")
	rules.advance(9,[[true,false],[false,true],[false,false]])
	check(rules.owners==[-1,-1,-1] and rules.scores==[0,0],"Capture needs ten seconds, not occupancy count")
	rules.advance(1,[[true,false],[false,true],[false,false]])
	check(rules.owners==[0,1,-1] and rules.scores==[0,0],"Capture gives no immediate income or retroactive credit")
	rules.advance(9,[[false,false],[false,false],[true,false]])
	check(rules.scores==[0,0],"Held income waits ten seconds")
	rules.advance(1,[[false,false],[false,false],[true,false]])
	check(rules.scores==[1,1] and rules.owners==[0,1,0],"Each held POI pays one point per ten seconds")
	check(rules.kill(0)==2 and rules.scores==[3,1],"Enemy kill multiplier equals held POI count")
	rules.advance(4,[[false,true],[false,false],[false,false]])
	rules.advance(20,[[true,true],[false,false],[false,false]])
	check(rules.progress[0][1]==4 and rules.owners[0]==0 and rules.contested[0],"Contesting pauses capture while held territory still earns income")
	rules.advance(1,[[false,false],[false,false],[false,false]])
	check(rules.progress[0]==[0.0,0.0],"Vacating capture area resets progress")
	rules.advance(10,[[false,true],[false,false],[false,false]])
	check(rules.owners[0]==1 and rules.credit[0]==0,"Enemy takeover resets that POI's income clock")
	var one:=Points.new();one.reset(1);one.advance(30,[[true,false]])
	check(one.scores==[2,0],"Large tick splits capture and subsequent income correctly")
	rules.reset(2);rules.owners=[0,1];rules.scores=[199,199];rules.credit=[9.0,8.0];rules.advance(20,[[false,false],[false,false]])
	check(rules.winner==0 and rules.scores==[200,199],"Earlier income threshold wins even during a long tick")
	rules.reset(2);rules.owners=[0,1];rules.scores=[199,199];rules.credit=[9.0,9.0];rules.advance(1,[[false,false],[false,false]])
	check(rules.winner==-1,"Truly simultaneous threshold is a draw")
	rules.reset(2);rules.owners=[0,0];rules.scores=[199,0];rules.kill(0)
	check(rules.winner==0 and rules.scores==[200,0] and rules.kill(0)==0,"Kill threshold ends and freezes scoring at 200")
	var clone:=Points.new();clone.reset(2);clone.receive(rules.snapshot());check(clone.snapshot()==rules.snapshot(),"Rule state round trips")
	print("CQ_FRONTIER_POINTS_RESULT ",JSON.stringify(failures));quit(0 if failures.is_empty() else 1)
