# Godot's generated imports and editor state
.godot/
*.import
# Authored sky import policy: retain full-resolution BC7 / ASTC 4x4 on fresh checkouts.
!/deathmatch/maps/skies/*.png.import
# Runtime dictionary reads original WAD bytes; do not import an unused scene.
!/deathmatch/maps/texture_replacements/makkon-used.wad.import
# Preserve mip generation for runtime art, including existing developer imports.
!/deathmatch/**/*.png.import
!/deathmatch/**/*.svg.import
!/addons/godot-xr-tools/hands/textures/*.png.import
!/addons/godot-xr-tools/images/*.png.import
!/addons/godot-xr-tools/assets/misc/*.png.import
# Generated Gradle project and local signing configuration
/android/
.env
.env.*
*.keystore
*.jks
*.p12
# Local build and test output
/test-results/
/release-assets/
__pycache__/
*.pyc
*.log
/addons/bhaptics_native/native/target/
/addons/bhaptics_native/bin/
/addons/bhaptics_native/bhaptics.gdextension
.DS_Store

# External libraries may contain private player/server downloads. Base files are tracked explicitly.
/maps/*.bsp
/maps/cache/*.scn
/maps/cache/*-import.json
/maps/previews/
/maps/*.download
/maps/*.upload
/vrm/*.vrm
/vrm/*.part

# Converted ThreeWave content is local/server-only.
**/threewave_*.bsp
**/ctf2m*.bsp

/Builds/

# Original TF conversions are local/server-only.
**/tf_original_*.bsp
**/2fort5.bsp
**/well6.bsp

# Locally installed optional TF assets are maintained in optional-tf-map-pack.
/maps/tf_*.lit
/maps/navigation/tf_*.res

# External map packs and player-supplied navigation stay separate from source packs.
/maps/*.lit
/maps/navigation/*.res

/maps/*.before-arena-pack-*
/maps/arena-collection-1/

/demos/
/video-output/
/recordings/

# Arcane Dimensions derivatives and source assets stay local.
**/ad_arena_*.bsp
**/ad_arena_*.lit
/optional-ad-tools/local/

/maps/AD-NOTICES/
/maps/ad_arena_*-README.txt
/maps/*_ad_maplist.txt
/maps/ad-maplists.cfg

# FortressOne conversions require separate rights and playability clearance.
**/tf_fo_*.bsp
**/tf_fo_*.scn
/tools/fortressone/local/

# Local BSP editor extraction output; never redistribute imported textures.
/materials/
/textures/
/optional-arena-pack/

/deathmatch/assets/offline-base.zip

# Downloaded third-party source archives and licence-review working files.
/tools/makkon/local/
/tools/community_maps/local/

# Blender backup files; editable .blend sources remain tracked.
*.blend1
*.blend2

# Independent converter checkouts; source lives in separate GitHub repositories.
/external-tools/

# ThreeWave references are study inputs only; never distributed.
/tools/threewave_rebuild/local/

/tools/koth/local/

/optional-librequake/
/optional-community/

# Generated distribution archives and compiler scratch output.
/dist/
/maps/*.prt
/maps/*.texinfo
/maps/*.vis
# Per-map compiler outputs; editable MAP/WAD sources remain in source releases.
/maps/ClassicDE/**/*.bsp
/maps/ClassicDE/**/*.lit
/maps/ClassicDE/**/*.prt
/maps/ClassicDE/**/*.vis
/maps/ClassicDE/**/*.texinfo
/maps/Dust2Rebuilt/*.bsp
/maps/Dust2Rebuilt/*.lit
/maps/Dust2Rebuilt/*.prt
/maps/Dust2Rebuilt/*.vis
/maps/Dust2Rebuilt/*.texinfo

# Separate experimental checkouts.
/.worktrees/

# ST source references and compiled maps remain local; runtime art ships in 0.20v.
/deathmatch/audio/music/skyward_relay*
/maps/Stonehenge/
/maps/ctf_stonehenge*
/maps/cache/ctf_stonehenge*
/maps/navigation/ctf_stonehenge*
/maps/Raindance/
/maps/ctf_raindance*
/maps/cache/ctf_raindance*
/maps/navigation/ctf_raindance*
/maps/Katabatic/
/maps/ctf_katabatic*
/maps/cache/ctf_katabatic*
/maps/navigation/ctf_katabatic*
/tools/katabatic/local/
/tools/tribes/sources/
/tools/tribes/refined/
/docs/audio/skyward-relay/

# Locally compiled optional gameplay extension.
/addons/fps_native/bin/
/addons/fps_native/build*/
/addons/fps_native/fps_native.gdextension
/addons/fps_native/.sconsign*
/addons/fps_native/src/*.os
/addons/fps_native/src/*.o

# Client-owned music is never imported, committed or packaged.
/bgm/*
!/bgm/.gdignore
