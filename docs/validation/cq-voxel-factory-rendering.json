  "scope": "Generated factory terrain, static and deterministic moving camera; 32 animated copies per bundled VRM with springs off and production distance LOD. Matched raster/patch/column-hybrid input and factory geometry; BSP is a different-content context case. Mono, no networking/combat/XR; columns support yaw-only cameras.",
  "setup_times": {
    "columns_hybrid_half_ms": 10.305,
    "columns_hybrid_ms": 7.732,
    "columns_hybrid_quarter_ms": 10.861,
    "columns_solid_ms": 6.952,
    "map_generation_ms": 838.126,
    "patch_lod_ms": 5.183,
    "raster_full_ms": 2.327,
    "raster_mesh_ms": 132.39
  },
